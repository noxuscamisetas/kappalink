{
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "noxuscamisetas\\.kappalink\\.com"
        }
      ],
      "dest": "/noxuscamisetas/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?:festalinda|festalindapersonalizados)\\.kappalink\\.com"
        }
      ],
      "dest": "/festalindapersonalizados/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "anabeatriznutricao\\.kappalink\\.com"
        }
      ],
      "dest": "/anabeatriznutricao/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
