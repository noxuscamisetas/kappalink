{
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Content-Security-Policy": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "^/joalheria(?:/.*)?$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/joalheria$",
      "headers": {
        "Location": "/joalheria/"
      },
      "status": 308
    },
    {
      "src": "^/.*$",
      "has": [
        {
          "type": "host",
          "value": "oqpagar\\.kappalink\\.com"
        }
      ],
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'",
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/oqpagar(?:/.*)?$",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?kappalink\\.com"
        }
      ],
      "headers": {
        "Location": "https://oqpagar.kappalink.com/"
      },
      "status": 308
    },
    {
      "src": "^/marianojoias(?:/.*)?$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.kappalink.com; style-src 'self' https://www.kappalink.com 'unsafe-inline'; img-src 'self' https://www.kappalink.com data:; connect-src 'none'; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.kappalink.com; style-src 'self' https://www.kappalink.com 'unsafe-inline'; img-src 'self' https://www.kappalink.com data:; connect-src 'none'; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true,
      "has": [
        {
          "type": "host",
          "value": "marianojoias\\.kappalink\\.com"
        }
      ]
    },
    {
      "src": "^/marianojoias$",
      "headers": {
        "Location": "/marianojoias/"
      },
      "status": 308
    },
    {
      "src": "^/academia$",
      "headers": {
        "Location": "/academia/"
      },
      "status": 308
    },
    {
      "src": "^/guardauminstante$",
      "headers": {
        "Location": "/guardauminstante/"
      },
      "status": 308
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "guardauminstante\\.kappalink\\.com"
        }
      ],
      "dest": "/guardauminstante/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "noxuscamisetas\\.kappalink\\.com"
        }
      ],
      "dest": "/noxuscamisetas/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?:festalinda|festalindapersonalizados)\\.kappalink\\.com"
        }
      ],
      "dest": "/festalindapersonalizados/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?:anabeatriz|anabeatriznutricao)\\.kappalink\\.com"
        }
      ],
      "dest": "/anabeatriznutricao/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "academia\\.kappalink\\.com"
        }
      ],
      "dest": "/academia/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "marianojoias\\.kappalink\\.com"
        }
      ],
      "dest": "/marianojoias/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "oqpagar\\.kappalink\\.com"
        }
      ],
      "dest": "/oqpagar/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?!www\\.)[a-z0-9-]+\\.kappalink\\.com"
        }
      ],
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "npm test"
}
