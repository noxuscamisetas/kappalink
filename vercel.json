{
  "routes": [
    {
      "src": "^/.*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Content-Security-Policy": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "noxuscamisetas\\.kappalink\\.com"
        }
      ],
      "dest": "/noxuscamisetas/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?:festalinda|festalindapersonalizados)\\.kappalink\\.com"
        }
      ],
      "dest": "/festalindapersonalizados/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?:anabeatriz|anabeatriznutricao)\\.kappalink\\.com"
        }
      ],
      "dest": "/anabeatriznutricao/$1"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(?!www\\.)[a-z0-9-]+\\.kappalink\\.com"
        }
      ],
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ],
  "buildCommand": "npm test"
}
